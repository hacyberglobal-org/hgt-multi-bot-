rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles - only the owner can read and write
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Sub-collections: bot configurations and notifications
      match /bot_configs/{configId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
